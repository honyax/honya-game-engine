# エディタ側の入力規則。
#
# .gitattributes が「Git がどう保存/取り出すか」なのに対して、
# こちらは「エディタが何を書き込むか」を決める。両方揃えて初めて
# reference と work の diff が改行コードで濁らなくなる。
#
# VSCode 本体は .editorconfig を読まない(拡張 EditorConfig.EditorConfig が必要)。
# VSCode だけで完結させたい場合は .vscode/settings.json 側が効く。
# このファイルは dotnet format / C# Dev Kit の整形や、他エディタ向け。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# PowerShell スクリプトは UTF-8 BOM 付きが必須。
# Windows PowerShell 5.1 は BOM 無し UTF-8 の日本語コメントを化けさせ、
# 構文エラーになる(.vscode/run.ps1 がこれに該当)
[*.ps1]
charset = utf-8-bom

# Markdown は行末2スペースが改行の意味を持つため、末尾空白を削らない
[*.md]
trim_trailing_whitespace = false
