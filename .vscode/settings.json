{
  // このワークスペースで新規作成するファイルの改行コードを LF にする。
  // これを設定しないと Windows の VSCode は CRLF で作るため、
  // LF で書かれている reference との diff に全行が差分として出てしまう。
  //
  // 注意: この設定が効くのは「新規作成するファイル」だけ。
  // 既にある CRLF のファイルは、画面右下のステータスバーの "CRLF" をクリックして
  // "LF" を選ぶと変換できる。
  "files.eol": "\n",

  // 改行コード以外にも diff を濁らせる要因があるので、併せて潰しておく。
  // 保存時に末尾の空白を削り、ファイル末尾に改行を1つ入れる。
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // Markdown だけは例外。行末の2スペースが「改行」の意味を持つため削らない
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  }
}
