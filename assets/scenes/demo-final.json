      "rotation": [14.0, 90.0, 0.0]
    },

    // ------------------------------------------------------------
    //  吊りランタン(Day 56)。Khronos のサンプル(CC0)。
    //  ファイルは cm で作られていて全高 25.7 なので、0.11 倍で 2.8m にする。
    //  柱から腕が伸び、その先にランタンが吊られている。右の開いた側に立て、180 度回して腕を通りの側へ向ける
    //  (回さないと腕が +X、通りの外へ伸びる。向きは「デモ v1」の F10 の内訳で部品の位置を見て決めた)。
    //
    //  **当たらない**。柱と腕を1つの箱にすると幅 1.7m・高さ 2.8m の箱になり、ランタンの下を歩けなくなる。
    // ------------------------------------------------------------
    {
      "name": "吊りランタン(手前)",
      "model": "models/Lantern.glb",
      "scale": 0.11,
      "position": [3.3, 0.0, 3.0],
      "rotation": [0.0, 180.0, 0.0],
      "collision": "none"
    },
    {
      "name": "吊りランタン(奥)",
      "model": "models/Lantern.glb",
      "scale": 0.11,
      "position": [3.3, 0.0, -8.0],
      "rotation": [0.0, 180.0, 0.0],
      "collision": "none"
    }
  ],

  // ------------------------------------------------------------
  //  灯り(Day 56)。**1つの項目に、照らす側と見える側を書く**。
  //
  //  照らす側(点光源。画面には写らない)
  //    color     … 色(0〜1)。見える側と共有する
  //    intensity … 強さ(距離 0 のときの明るさ。Day 52 と同じ単位)
  //    radius    … 届く距離 [m]。ここでちょうど 0 になる
  //    flicker   … 揺らぎの深さ(0〜1)。見える側も同じだけ揺らぐ
  //    position  … 置き場所。書かなければ見える側から決める(下)
  //
  //  見える側(glow。光る材質。まわりは照らさない)
  //    strength  … 明るさ(色に掛ける)。ブルームと被写界深度のボケに効くのはこちら
  //    prop + match               … 小物の部品を光らせる。照らす側はその部品の真ん中に置く
  //    size + rotation + position … 光る板を足す(影を落とさず、当たらない)。照らす側は板の 40cm 手前に置く
  // ------------------------------------------------------------
  "lights": [
    {
      // 街灯。**ガラスを光らせ、電球の位置から照らす**(ガラスは材質で分かれている)。
      "name": "街灯",
      "color": [1.0, 0.62, 0.32],
      "intensity": 14.0,
      "radius": 9.0,
      "glow": { "prop": "街灯", "match": "glass", "strength": 6.0 }
    },
    {
      // 左の壁の窓。壁(x = -4)より 2cm 手前に貼る。rotation 90 で +X(通りの側)を向く。
      "name": "窓(手前)",
      "color": [1.0, 0.76, 0.48],
      "intensity": 6.0,
      "radius": 5.5,
      "glow": { "size": [1.1, 1.5], "rotation": [0.0, 90.0, 0.0], "position": [-3.98, 2.3, 6.0], "strength": 1.1 }
    },
    {
      "name": "窓(奥)",
      "color": [1.0, 0.7, 0.42],
      "intensity": 4.0,
      "radius": 4.5,
      "glow": { "size": [1.1, 1.5], "rotation": [0.0, 90.0, 0.0], "position": [-3.98, 2.5, -9.0], "strength": 1.1 }
    },
    {
      // 突き当りの壁の看板。**色を足すための灯り**——暖色ばかりの通りに1つだけ別の色を置く。
      // 見える側を明るくしすぎると、赤が 1.0 を超えて頭打ちになり、白っぽい桃色に転ぶ(露出 1.3 で 2.5 まで)。
      "name": "看板",
      "color": [1.0, 0.16, 0.48],
      "intensity": 6.0,
      "radius": 5.5,
      "glow": { "size": [2.4, 0.55], "rotation": [0.0, 0.0, 0.0], "position": [1.6, 3.1, -12.98], "strength": 2.5 }
    },
    {
      // 裏口の蛍光灯。**切れかけている**(揺らぎを深く)。
      "name": "裏口の蛍光灯",
      "color": [0.72, 1.0, 0.86],
      "intensity": 3.0,
      "radius": 3.5,
      "flicker": 0.75,
      "glow": { "size": [0.7, 0.1], "rotation": [0.0, 0.0, 0.0], "position": [-2.2, 2.5, -12.98], "strength": 4.0 }
    },
    {
      // 吊りランタン。部品で分かれている(LanternPole_Lantern)。ガラスの模様は発光テクスチャが持っているので、
      // こちらが決めるのは色と明るさだけ。**炎なので浅く揺らぐ**。
      "name": "ランタン(手前)",
      "color": [1.0, 0.5, 0.2],
      "intensity": 5.0,
      "radius": 4.5,
      "flicker": 0.25,
      "glow": { "prop": "吊りランタン(手前)", "match": "_Lantern", "strength": 4.0 }
    },
    {
      "name": "ランタン(奥)",
      "color": [1.0, 0.5, 0.2],
      "intensity": 5.0,
      "radius": 4.5,
      "flicker": 0.25,
      "glow": { "prop": "吊りランタン(奥)", "match": "_Lantern", "strength": 4.0 }
    }
  ]
}
