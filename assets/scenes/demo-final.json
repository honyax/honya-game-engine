{
  // ============================================================
  //  最終デモ(Day 56)— 宵の裏通り
  //
  //  Day 39 の demo-v1.json をまるごと写し、3つを足したもの。
  //    1. lighting.night … 夜の強さと露出(Day 52 で Program が 3% と決め打ちしていたもの)
  //    2. lights         … 灯り。照らす側(点光源)と見える側(光る材質)を1つの項目に書く
  //    3. 吊りランタン   … 灯りのための小物を2つ
  //
  //  **demo-v1.json には書き足さない**。assets/ は全部の Day で共有しているので、
  //  v1 に板を1枚足すだけで Day 39〜55 の絵と自己チェックが変わってしまう。
  //  新しいキー(lights / night)だけなら古い Day は黙って飛ばすが、
  //  窓の板や小物は古い Day も描いてしまう。
  //
  //  このファイルは「最終デモ」の F2 で読む。数字を書き換えたら「デモ v1」の F11 で読み直せる
  //  (Day 56 からは、いま出ているシーンを読み直す)。
  // ============================================================
  "name": "宵の裏通り",

  "hdri": "hdri/spruit_sunrise_2k.hdr",

  "lighting": {
    "exposure": 0.5,
    "iblIntensity": 1.0,
    "sunScale": 1.0,
    "ambient": [0.0, 0.0, 0.0],
    "removeSunFromIbl": true,
    "sunThreshold": 0.05,
    "sunAzimuth": 25.0,
    "shadowRadius": 16.0,

    "grade": {
      "enabled": true,
      "temperature": 14.0,
      "tint": 3.0,
      "contrast": 1.08,
      "saturation": 1.06
    },

    // ------------------------------------------------------------
    //  夜(Day 56)。「最終デモ」の F4 と「ディファード」の F4 で切り替える。
    //
    //  sunScale … 太陽に掛ける倍率。夜は月明かりの代わりにする(向きは太陽のまま)。
    //             0 にすると影が1つも落ちなくなる——点光源は影を持たないので。
    //  iblScale … 空(IBL)に掛ける倍率。金属に映る景色もこれで暗くなる。
    //  exposure … 夜の露出。昼の 0.5 のまま暗くすると、灯りの届かないところが真っ黒で通りの形が読めない。
    //             本物のカメラも暗くなれば露出を上げる。
    // ------------------------------------------------------------
    "night": {
      "sunScale": 0.05,
      "iblScale": 0.07,
      "exposure": 1.3
    }
  },

  "player": {
    "spawn": [-0.5, 0.0, 5.5],
    "yaw": 180.0
  },

  "camera": {
    "target": [-1.2, 1.3, -1.5],
    "distance": 10.5,
    "yaw": 32.0,
    "pitch": 10.0,
    "fov": 40.0,

    // ------------------------------------------------------------
    //  夜のカメラワーク(Day 56)。v1 の5ショットのうち2つを残し、3つを差し替えた。
    //  **寄りのショットは画角を狭めて、奥に灯りを置く**——被写界深度のボケが丸く出るのは、
    //  ピントの外にある明るい点(ガラス・看板)だけだから(Day 55 の要点3: 望遠ほどボケる)。
    // ------------------------------------------------------------
    "shots": [
      {
        "name": "通りを見渡す",
        "target": [-1.2, 1.4, -1.5],
        "distance": 12.0,
        "yaw": 32.0,
        "pitch": 12.0,
        "fov": 40.0,
        "hold": 3.0,
        "travel": 6.0
      },
      {
        // 消火栓にピントを置き、奥の街灯と看板をボケにする。
        "name": "消火栓と灯りのボケ",
        "target": [-3.2, 0.55, 2.6],
        "distance": 2.6,
        "yaw": 18.0,
        "pitch": 6.0,
        "fov": 30.0,
        "hold": 3.0,
        "travel": 5.0
      },
      {
        "name": "街灯を見上げる",
        "target": [-3.4, 3.6, -4.0],
        "distance": 3.5,
        "yaw": -7.0,
        "pitch": -44.0,
        "fov": 50.0,
        "hold": 2.5,
        "travel": 5.0
      },
      {
        // 突き当りの看板と、切れかけた蛍光灯。**揺らぎがいちばん見えるショット**。
        "name": "看板と蛍光灯",
        "target": [0.0, 2.2, -12.0],
        "distance": 6.0,
        "yaw": 12.0,
        "pitch": 4.0,
        "fov": 38.0,
        "hold": 3.0,
        "travel": 6.0
      },
      {
        // 通りの外からランタン越しに振り返る。奥の窓と街灯がボケる。
        "name": "ランタン越しに",
        "target": [2.7, 1.8, -8.0],
        "distance": 3.0,
        "yaw": 125.0,
        "pitch": 6.0,
        "fov": 32.0,
        "hold": 3.0,
        "travel": 6.0
      }
    ]
  },

  "materials": [
    {
      "name": "pavement",
      "baseColor": "textures/pbr/pavement_02/pavement_02_diff_1k.jpg",
      "normal": "textures/pbr/pavement_02/pavement_02_nor_gl_1k.jpg",
      "orm": "textures/pbr/pavement_02/pavement_02_arm_1k.jpg",
      "height": "textures/pbr/pavement_02/pavement_02_disp_1k.jpg",
      "uvScale": [30, 30],
      "parallaxScale": 0.02
    },
    {
