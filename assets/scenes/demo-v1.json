{
  // ============================================================
  //  デモ v1(Day 39)— 夕暮れの裏通り
  //
  //  パスはすべて assets/ からの相対。座標は右手系・単位はメートル。
  //  Y が上。通りは Z 軸に沿って伸びていて、**壁は左(-X)と突き当りだけ**。
  //
  //  片側を開けてあるのには理由がある。
  //  この HDRI の太陽は仰角が 8 度しかないので、
  //  両側に高い壁を立てると **床にまったく日が当たらない**
  //  (高さ 5.5m の壁が 39m 先まで影を落とす)。
  //  「夕方のシーンは壁を減らす」は絵作りの定石で、
  //  太陽の仰角を測ってから決めるのが今日のやり方。
  //
  //  このファイルは Ctrl+Shift+F10 で読み直せる。数字を書き換えて保存 → 押す。
  //  JSON だがコメントと末尾カンマを許す設定で読んでいる(DemoScene.Load)。
  // ============================================================
  "name": "夕暮れの裏通り",

  // 環境マップの元。Ctrl+Shift+F3 で他の HDRI に切り替えられる。
  "hdri": "hdri/spruit_sunrise_2k.hdr",

  "lighting": {
    // Day 31 の露出。HDRI の絶対輝度に合わせて決める値で、
    // 「正しい数字」があるわけではない(絵づくりの側)。
    "exposure": 0.5,

    // IBL の強さ(Day 36)。1.0 が物理どおり。
    "iblIntensity": 1.0,

    // 抽出した太陽の強さの倍率。1.0 が物理どおり。
    "sunScale": 1.0,

    // IBL があるので定数の環境光は 0。足すと三重計上になる。
    "ambient": [0.0, 0.0, 0.0],

    // 環境マップから太陽を抜く(二重計上を消す)。Ctrl+Shift+F5 で切り替え。
    "removeSunFromIbl": true,

    // 太陽と判定するしきい値(最大輝度に対する比)。Ctrl+Shift+F6 で切り替え。
    "sunThreshold": 0.05,

    // 太陽に来てほしい方位(度)。空のほうを回して合わせる。
    // 25 度 = 「右手前から差し込んで、左の壁を斜めに舐める」向き。
    "sunAzimuth": 25.0,

    // シャドウマップが覆う半径。太陽が低いぶん影が長いので広めに取る。
    // ここを 6(既定)に戻すと、遠くの影が箱から出て**途中で切れる**——
    // Day 33 で「実際のエンジンは箱を何段も作る」と書いたカスケードが
    // 要る理由が、そのまま絵に出る。
    "shadowRadius": 16.0,

    // カラーグレーディング(Day 40 で足した)。Day 38 の ColorGrade に流し込む。
    // 露出や IBL の強さと同じで「この絵をどう見せたいか」の一部なので、
    // コードではなくシーンの持ち物にしてある。
    // Shift+F6〜F10 でいつでも上書きできる(戻すには Ctrl+Shift+F10)。
    "grade": {
      "enabled": true,

      // 正が暖色。夕暮れなので少しだけ温める。**入れすぎると HDRI の色が死ぬ**——
      // 空からの光がすでに夕方の色なので、ここは「味付け」の範囲に留める。
      "temperature": 14.0,
      "tint": 3.0,
      "contrast": 1.08,
      "saturation": 1.06
    }
  },

  // ------------------------------------------------------------
  //  プレイヤー(Day 51)。プレイアブルデモの出発点。
  //
  //  spawn は**足元**の位置。yaw は向いている方角(度)で、0 が +Z。
  //  180 にすると通りの奥(-Z、突き当りの壁の方向)を向いて始まる。
  //
  //  カメラの「決めの構図」とは別に持っている。あちらは
  //  「この絵をどう見せたいか」、こちらは「どこから遊び始めるか」で、
  //  同じ数字にしたくなる場面はあっても意味が違う。
  //
  //  Day 39〜50 はこの節を読まない(知らないキーは飛ばされる)ので、
  //  足しても過去の Day の絵は1ピクセルも変わらない。
  // ------------------------------------------------------------
  "player": {
    "spawn": [-0.5, 0.0, 5.5],
    "yaw": 180.0
  },

  // ------------------------------------------------------------
  //  カメラ。直下の4項目が決めの構図(Ctrl+Shift+F12)で、
  //  shots がカメラワーク(Ctrl+Alt+F1。Day 40)。角度はすべて度。
  //
  //  fov は垂直画角。Camera の既定は 60 度だが、それは
  //  「操作するゲーム」の画角で、デモの絵には広すぎる(壁が倒れて見える)。
  // ------------------------------------------------------------
  "camera": {
    "target": [-1.2, 1.3, -1.5],
    "distance": 10.5,
    "yaw": 32.0,
    "pitch": 10.0,
    "fov": 40.0,

    // ------------------------------------------------------------
    //  カメラワーク。**書かなかった項目は前のショットを引き継ぐ**ので、
    //  変えたい数字だけ書けばよい(1つ目は上の決めの構図が土台)。
    //
    //  hold   … そのショットで静止する秒数
    //  travel … 次のショットへ移るのに掛ける秒数
    //
    //  経路は輪になっていて、最後のショットから1つ目へ戻る。
    //  方位の合計が 0 になるように組んであるので、
    //  何周してもぐるぐる回り続けることはない。
    // ------------------------------------------------------------
    "shots": [
      {
        // 通りの全景。ここが1周の始まりで、いちばん長く止める。
        "name": "通りを見渡す",
        "target": [-1.2, 1.4, -1.5],
        "distance": 12.0,
        "yaw": 32.0,
        "pitch": 12.0,
        "fov": 40.0,
        "hold": 3.0,
        "travel": 6.0
      },
      {
        // 金属の寄り。**IBL がいちばん効くショット**——
        // Ctrl+Alt+F8 で IBL を切ると胴が真っ黒になる。
        "name": "ゴミ箱の金属",
        "target": [-2.9, 0.55, -0.4],
        "distance": 3.2,
        "yaw": 55.0,
        "pitch": 8.0,
        "fov": 35.0,
        "hold": 3.0,
        "travel": 5.0
      },
      {
        // 見上げ。**pitch を負にすると見上げになる**。
        // 壁のすぐ内側に立って空を向くので、街灯が空に抜ける——
        // HDRI そのものを見せるショットでもある。
        // 仰角を -20 度あたりまで戻すと壁で埋まるので、そこが下限。
        "name": "街灯を見上げる",
        "target": [-3.4, 3.6, -4.0],
        "distance": 3.5,
        "yaw": -7.0,
        "pitch": -44.0,
        "fov": 50.0,
        "hold": 2.5,
        "travel": 5.0
      },
      {
        // 壁を斜めに舐める光。**法線マップと視差がいちばん効くショット**。
        // 街灯の影が壁を横切るので、影の縁(PCF)もここで見える。
        "name": "壁を舐める光",
        "target": [-3.6, 2.0, -6.0],
        "distance": 9.0,
        "yaw": 8.0,
        "pitch": 6.0,
        "fov": 42.0,
        "hold": 3.0,
        "travel": 6.0
      },
      {
        // 低い太陽が引く長い影。**影と SSAO の差が出るショット**。
        "name": "消火栓と長い影",
        "target": [-3.2, 0.6, 2.6],
        "distance": 4.5,
        "yaw": 35.0,
        "pitch": 14.0,
        "fov": 42.0,
        "hold": 3.0,
        "travel": 6.0
      }
    ]
  },

  // ------------------------------------------------------------
  //  板に貼る材質。Poly Haven の ARM(R=AO / G=粗さ / B=金属度)を
  //  orm に1枚指定すると、AO とメタリック・ラフネスの両方に回る。
  //
  //  れんがが2つあるのは uvScale だけの違い。板の大きさが違うので、
  //  同じ倍率だと目地の大きさが揃わない。
  //  テクスチャの実体は RenderResources が使い回すので、VRAM は増えない。
  // ------------------------------------------------------------
  "materials": [
    {
      "name": "pavement",
      "baseColor": "textures/pbr/pavement_02/pavement_02_diff_1k.jpg",
      "normal": "textures/pbr/pavement_02/pavement_02_nor_gl_1k.jpg",
      "orm": "textures/pbr/pavement_02/pavement_02_arm_1k.jpg",
      "height": "textures/pbr/pavement_02/pavement_02_disp_1k.jpg",

      // 地面は 60m 角なので、30 で 1 タイル 2m。
      // **広めに取る**のは、板の端と HDRI の地面の境目を画面から追い出すため。
      "uvScale": [30, 30],
      "parallaxScale": 0.02
    },
    {
      "name": "brick",
      "baseColor": "textures/pbr/red_brick_03/red_brick_03_diff_1k.jpg",
      "normal": "textures/pbr/red_brick_03/red_brick_03_nor_gl_1k.jpg",
      "orm": "textures/pbr/red_brick_03/red_brick_03_arm_1k.jpg",
      "height": "textures/pbr/red_brick_03/red_brick_03_disp_1k.jpg",

      // 左の壁は 24m x 5.5m。1 タイル 2m 相当。
      "uvScale": [12, 2.75],
      "parallaxScale": 0.035
    },
    {
      "name": "brick-end",
      "baseColor": "textures/pbr/red_brick_03/red_brick_03_diff_1k.jpg",
      "normal": "textures/pbr/red_brick_03/red_brick_03_nor_gl_1k.jpg",
      "orm": "textures/pbr/red_brick_03/red_brick_03_arm_1k.jpg",
      "height": "textures/pbr/red_brick_03/red_brick_03_disp_1k.jpg",

      // 突き当りは 11m x 4.5m。こちらも 1 タイル 2m 相当になるように。
      "uvScale": [5.5, 2.25],
      "parallaxScale": 0.035
    }
  ],

  // ------------------------------------------------------------
  //  板(地面と壁)。板はもともと +Z を向いているので、
  //  rotation で向きを作る。size は板そのものの縦横(メートル)。
  // ------------------------------------------------------------
  "surfaces": [
    {
      "name": "地面",
      "material": "pavement",
      "size": [60.0, 60.0],
      "rotation": [-90.0, 0.0, 0.0],
      "position": [0.0, 0.0, 0.0],

      // 当たり判定は**無限平面**(Day 51)。板そのものを箱にすると
      // 厚み 0 の 60m 角になり、端から落ちる。地面だけは平面が正しい。
      "collision": "plane",

      // 地面は影の受け手。落とす側ではないので深度パスに入れない
      // (自分の影で表面が縞になるのを避ける)。
      "castShadow": false
    },
    {
      "name": "左の壁",
      "material": "brick",
      "size": [24.0, 5.5],
      "rotation": [0.0, 90.0, 0.0],
      "position": [-4.0, 2.75, -2.0],
      "castShadow": true,

      // 書かなくても箱になる(既定)が、**壁は当たってほしい側**なので明示する。
      "collision": "box"
    },
    {
      "name": "突き当りの壁",
      "material": "brick-end",
      "size": [11.0, 4.5],
      "rotation": [0.0, 0.0, 0.0],
      "position": [-0.5, 2.25, -13.0],
      "castShadow": true,
      "collision": "box"
    }
  ],

  // ------------------------------------------------------------
  //  小物(Poly Haven の CC0 モデル)。
  //  position は「床のどこに立たせるか」。足元と水平の中心が
  //  自動で原点に合うので、y は 0 でよい(align: false で切れる)。
  //  rotation は度で [X, Y, Z]。
  // ------------------------------------------------------------
  "props": [
    {
      "name": "街灯",
      "model": "models/street_lamp_01/street_lamp_01_1k.gltf",
      "position": [-3.4, 0.0, -4.0],
      "rotation": [0.0, 180.0, 0.0]
    },
    {
      "name": "ゴミ箱",

      // このファイルには「きれいな版」と「錆びた版」が並べて入っている。
      // 2 個並んだ絵がちょうどよいので、どちらも落とさない。
      // **金属なので IBL がいちばん効く**——Ctrl+Alt+1 で切ると胴が真っ黒になる。
      "model": "models/metal_trash_can/metal_trash_can_1k.gltf",
      "position": [-2.9, 0.0, -0.4],
      "rotation": [0.0, 72.0, 0.0]
    },
    {
      "name": "消火栓",

      // こちらも2体入っているが、消火栓が並んでいるのは変なので
      // 「錆びた版」を名前で落とす。
      "model": "models/fire_hydrant/fire_hydrant_1k.gltf",
      "skipNodes": ["aged"],
      "position": [-3.2, 0.0, 2.6],
      "rotation": [0.0, -35.0, 0.0]
    },
    {
      "name": "道路バリア(手前)",
      "model": "models/concrete_road_barrier/concrete_road_barrier_1k.gltf",
      "position": [2.2, 0.0, 0.9],
      "rotation": [0.0, 84.0, 0.0]
    },
    {
      "name": "道路バリア(奥)",
      "model": "models/concrete_road_barrier/concrete_road_barrier_1k.gltf",
      "position": [2.35, 0.0, -1.0],
      "rotation": [0.0, 96.0, 0.0]
    },
    {
      "name": "古タイヤ(倒し)",

      // タイヤは XY 平面の円板として作られているので、X を 90 度回すと寝る。
      // 足元合わせは回したあとに効くので、y は 0 のままでよい。
      "model": "models/old_tyre/old_tyre_1k.gltf",
      "position": [-1.1, 0.0, 0.7],
      "rotation": [90.0, 0.0, 20.0],

      // **これだけ当たらない**(Day 51)。寝かせたタイヤを世界軸の箱にすると
      // 直径 1m・厚み 25cm の板になり、歩いていて<b>床の途中で急に 25cm の段差</b>が出る。
      // 乗り越えの上限(全高の 35% = 25cm)ぎりぎりなので、
      // 越えられたり弾かれたりして気持ちが悪い。踏めるほうが自然なので通す。
      "collision": "none"
    },
    {
      "name": "古タイヤ(立てかけ)",
      "model": "models/old_tyre/old_tyre_1k.gltf",
      "position": [-3.72, 0.0, -6.2],
      "rotation": [14.0, 90.0, 0.0]
    }
  ]
}
