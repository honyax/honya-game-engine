<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinExe: 起動時にコンソールウィンドウを出さない実行形式。
      Exe にするとゲームウィンドウの裏に黒いコンソールが付いてくる。
    -->
    <OutputType>WinExe</OutputType>

    <!--
      net10.0-windows: WinForms(System.Drawing / System.Windows.Forms)はWindows専用APIなので、
      TargetFrameworkにOSサフィックスが必要。Phase 0〜1はこの構成で進める。
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      AssemblyName は明示しない。省略するとcsprojのファイル名(Day08.csproj)が使われ、
      出力は Day08.dll になる。Dayを増やすときはcsprojをリネームするだけで
      出力名も追従するので、.vscode/launch.json の「フォルダ名 = 出力名」の前提が崩れない。
    -->
    <!--
      名前空間はDay番号を含めない。**Phase単位**で固定する。
      Day 1(Phase 0)は Framebuffer、Day 2〜10(Phase 1)は SoftwareRasterizer、
      Day 11〜13(Phase 2)は RawGL、Day 14〜(Phase 3以降)は HonyaEngine。

      Dayごとに変えると、Day間の差分(git diff)に全ファイルの namespace 行が乗ってしまい、
      その日の本当の差分が埋もれるため。
      写経先の work/SoftwareRasterizer とも一致するので、そちらとの差分も綺麗になる。
    -->
    <RootNamespace>SoftwareRasterizer</RootNamespace>

    <!--
      高DPI環境(スケーリング125%/150%等)でOSに画面を引き伸ばされると、
      「フレームバッファの1ピクセル = 画面の1ピクセル」が崩れて絵がぼやける。
      PerMonitorV2 を宣言してDPIスケーリングを自前の責任にすることで、
      ClientSize で指定した値が実ピクセル数として扱われるようにする。
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
