<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinExe: 起動時にコンソールウィンドウを出さない実行形式。Phase 0〜1 と同じ。
    -->
    <OutputType>WinExe</OutputType>

    <!--
      net10.0-windows のままにする理由は2つ。
        1. .vscode/launch.json が bin/Debug/net10.0-windows/ を決め打ちしている
        2. このプロジェクトは Win32 API を直接叩くので、そもそも Windows 専用である
           ことをターゲットフレームワークで宣言しておくのが正しい
      ただし UseWindowsForms は **書かない**。Phase 2 の主題は
      「WinForms が代行していた仕事を自分で書く」ことなので、参照ごと外す。
    -->
    <TargetFramework>net10.0-windows</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      名前空間は Phase 単位で固定する。Phase 2(Day 11〜13)は RawGL。
      Day 10 までの SoftwareRasterizer とは別プロジェクトになるので、
      work 側も work/RawGL を新規に作ることになる。
    -->
    <RootNamespace>RawGL</RootNamespace>

    <!--
      ApplicationHighDpiMode は **消えている**。
      あれは WinForms のソースジェネレータが ApplicationConfiguration.Initialize() に
      展開するプロパティで、WinForms を参照しない今のプロジェクトでは何の効果もない。
      同じことを Program.Main の先頭で SetProcessDpiAwarenessContext を呼んで自分でやる。
    -->
  </PropertyGroup>

</Project>
