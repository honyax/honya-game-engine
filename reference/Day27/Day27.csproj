<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HonyaEngine</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <!--
      PNG/JPG のデコーダ。stb_image(C言語の定番1ファイルライブラリ)の C# 移植で、
      依存が無く MIT。Silk.NET 自体は画像読み込みを持たないので、別途こういうものが要る。
      「画像フォーマットの解析」は本ロードマップの主題ではないので、ここは既製品に任せる。
    -->
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <!--
      OpenAL のバインディング。Silk.NET ファミリーなので、
      OpenGL 側と同じ「薄い P/Invoke ラッパ」の作りになっている。
    -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <!--
      OpenAL Soft の本体(soft_oal.dll)。OpenAL は**仕様**であって実装ではないので、
      別途どれかの実装が要る。Windows には昔 Creative のドライバが入っていたが、
      今は同梱するのが普通。LGPL だが、動的リンクで使うぶんには問題にならない。
    -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>
</Project>
