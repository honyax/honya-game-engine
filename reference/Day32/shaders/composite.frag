#version 330 core

// **HDR パイプラインの出口**。ここだけが画面(既定のフレームバッファ)へ書く。
//
// やることは4つで、**順番に意味がある**。
//   1. 露出        … 「カメラの絞り」。何を 1.0 とみなすかを決める
//   2. ブルーム合成 … 滲みを足す。**トーンマップの前**に足す(あとで理由)
//   3. トーンマップ … 0〜∞ を 0〜1 へ畳む
//   4. ガンマ      … リニアな明るさを、ディスプレイが期待する符号化へ戻す
//
// 3 と 4 を逆にすると絵が破綻する。
// トーンマップの曲線は**リニアな明るさを入れる前提**で設計されているので、
// ガンマをかけた値を通すと、暗部が持ち上がりすぎて全体が白っぽくなる。

in vec2 vUv;

out vec4 FragColor;

uniform sampler2D uScene;

/// ブルームのぼかし結果、または中間バッファの表示(uDebug が 2, 3 のとき)。
uniform sampler2D uBloom;

uniform float uExposure;
uniform float uBloomIntensity;

/// 0=なし 1=Reinhard 2=ACES
uniform int uToneMap;

/// 0=最終 1=シーンのみ(ブルーム無し) 2=明部の抽出 3=ぼかし後
uniform int uDebug;

// --- トーンマッピング -----------------------------------------------------
//
// トーンマッピングは「0〜∞ の明るさを 0〜1 に畳む」関数。
// 写真の現像でネガの濃度を印画紙の濃度に写す作業と同じ役割で、
// 名前も映画・写真の tone mapping から来ている。
//
// **どう畳むかは物理ではなく好み**。だから正解は無く、いくつも流儀がある。

/// いちばん素朴な畳み方。x / (1 + x)。
///
/// 0 は 0 に、1 は 0.5 に、∞ は 1 に写る。単調増加で必ず 1 未満に収まる。
/// 短くて計算も軽いが、**中間の明るさが軒並み暗くなる**のが難点で、
/// 全体に眠い(コントラストの無い)絵になりやすい。
vec3 Reinhard(vec3 x)
{
    return x / (1.0 + x);
}

/// 映画のフィルムに近い畳み方の近似(Krzysztof Narkowicz による ACES のカーブフィット)。
///
/// ACES(Academy Color Encoding System)は映画業界の色管理規格で、
/// 本来は 3x3 行列を2回挟む重い変換だが、
/// **見た目のほとんどはこの1本の有理式で再現できる**というのが元記事の主張。
///
/// Reinhard との違いは両端の形。
///   - 暗部で少し持ち上がる(足がついている)ので、影が潰れずコントラストが立つ
///   - 明部が S 字で緩やかに寝るので、白飛びの手前に「粘り」が出る
/// ゲームで「フィルムっぽい」と言われる絵は、だいたいこの形をしている。
vec3 AcesFilmic(vec3 x)
{
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;

    return clamp((x * ((a * x) + b)) / ((x * ((c * x) + d)) + e), 0.0, 1.0);
}

// --- ガンマ ---------------------------------------------------------------

/// リニアな明るさ → sRGB の符号化。**画面に出す直前の最後の1手**。
///
/// ディスプレイは受け取った値をだいたい 2.2 乗して光らせるので、
/// こちらは 1/2.2 乗して渡す。そうすると打ち消し合って、
/// 計算に使ったリニアな明るさがそのまま目に届く。
///
/// 正確な sRGB は暗部だけ直線にした折れ線だが、
/// 2.2 乗との差は見た目には出ない。厳密さが要るなら
/// GL_FRAMEBUFFER_SRGB を有効にして GPU に任せる手もある。
vec3 LinearToSrgb(vec3 color)
{
    return pow(max(color, vec3(0.0)), vec3(1.0 / 2.2));
}

void main()
{
    // 中間バッファをそのまま見るモード。**パイプラインの途中を目で確かめる**ためだけにある。
    // 後処理は「絵が変」以外の症状が出ないので、段ごとに切り出して見られるかどうかで
    // 原因追跡の手間が桁で変わる。
    if (uDebug >= 2)
    {
        FragColor = vec4(LinearToSrgb(texture(uBloom, vUv).rgb * uExposure), 1.0);
        return;
    }

    vec3 color = texture(uScene, vUv).rgb;

    // 1. 露出。**トーンマップより前**に掛ける。
    //    トーンマップは「1.0 付近をどう扱うか」の関数なので、
    //    その前に「何を 1.0 とみなすか」を決めておく必要がある。
    //    暗いシーンで露出を上げれば見えるようになり、明るいシーンで下げれば白飛びが減る——
    //    カメラの絞りやシャッター速度と、役割がそのまま同じ。
    color *= uExposure;

    // 2. ブルームを足す。**トーンマップの前**。
    //    後で足すと、すでに 0〜1 に畳まれた絵の上に光を重ねることになり、
    //    明るいところが簡単に 1.0 を突き抜けて、滲みが白い板になる。
    //    前に足せば、滲みぶんもまとめて畳まれるので階調が残る。
    if (uDebug == 0)
    {
        color += texture(uBloom, vUv).rgb * uBloomIntensity * uExposure;
    }

    // 3. トーンマップ。
    if (uToneMap == 1)
    {
        color = Reinhard(color);
    }
    else if (uToneMap == 2)
    {
        color = AcesFilmic(color);
    }
    else
    {
        // 「なし」= 1.0 で切り捨てるだけ。**白飛びがそのまま出る**のを見るためのモード。
        // Day 30 までの絵は、実質ずっとこれだった。
        color = clamp(color, 0.0, 1.0);
    }

    // 4. ガンマ。
    FragColor = vec4(LinearToSrgb(color), 1.0);
}
