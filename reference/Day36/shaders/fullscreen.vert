#version 330 core

// 入力属性がひとつも無い。位置も UV も、頂点番号から計算する。
out vec2 vUv;

// 画面全体を覆う三角形を、**頂点バッファ無しで**作る。
//
// 後処理は「画面のピクセルを1回ずつ通す」のが仕事なので、
// 頂点は3個(または4個)あれば足りる。そのためだけに VBO を作って
// 毎回バインドするより、頂点シェーダで頂点番号から座標を計算したほうが短い。
//
// gl_VertexID は glDrawArrays が数えている「何個目の頂点か」。
// 0, 1, 2 に対して:
//   ID=0 -> uv(0,0)  pos(-1,-1)   画面の左下
//   ID=1 -> uv(2,0)  pos( 3,-1)   右へ大きくはみ出す
//   ID=2 -> uv(0,2)  pos(-1, 3)   上へ大きくはみ出す
//
// **四角形(2枚の三角形)ではなく、はみ出した三角形1枚**にするのが定番。
// 四角形だと対角線上のピクセルが2つの三角形の境目になり、
// GPU が 2x2 のピクセル単位で処理する都合で、その線上だけ2回走る。
// 三角形1枚なら境目そのものが無い。数%の話だが、タダなので受け取っておく。
//
// はみ出したぶんはクリップされて捨てられるので、絵には出ない。
void main()
{
    vec2 uv = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);

    vUv = uv;

    // uv 0〜2 を -1〜3 に。0〜1 の部分がちょうど画面全体に対応する。
    gl_Position = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
}
