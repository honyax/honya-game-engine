#version 330 core

// **明るい部分だけを抜き出す**(ブルームの1段目)。
//
// ブルームは「まぶしいものの周りが滲む」現象を真似たもの。
// レンズやまつ毛や眼球の中で光が散るせいで、
// 実際の目にもカメラにも起きる。CG で足すのは「絵として明るさを伝える」ため——
// 画面が出せる最大の白は 1.0 で頭打ちなので、
// **1.0 を超えていることは、周りへの滲みでしか表現できない**。
//
// だからしきい値は 1.0 のあたりに置く。
// これを 0.5 などに下げると「明るくない部分」まで滲んで、画面全体が霞む。

in vec2 vUv;

out vec4 FragColor;

uniform sampler2D uScene;

/// これより明るいところを抜き出す。
uniform float uThreshold;

void main()
{
    vec3 color = texture(uScene, vUv).rgb;

    // 明るさ(輝度)は3チャンネルの単純な平均ではなく、**人の目の感度で重み付け**する。
    // 目は緑にいちばん敏感で、青にはほとんど鈍い。
    // 平均にすると、同じ数値の青が緑と同じだけ光ることになって不自然になる。
    // 係数は Rec.709(HDTV の規格)のもの。
    float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));

    // **ソフトニー**。しきい値でスパッと切ると、
    // 明るさが少しずつ変わる面(球のハイライトなど)に
    // **「ここから光る」という輪郭線**が出てしまう。
    // カメラが動くと、その線が面の上を這うのがはっきり見える。
    //
    // そこで、しきい値の前後 knee の幅だけ、なめらかに立ち上げる。
    // smoothstep は 0〜1 を3次曲線で繋ぐ関数で、両端の傾きが 0 になるので継ぎ目が見えない。
    float knee = max(uThreshold * 0.5, 0.0001);
    float weight = smoothstep(uThreshold - knee, uThreshold + knee, luminance);

    // **色は保ったまま、明るさだけを削る**。
    // color * weight ではなく、しきい値ぶんを引く書き方もあるが、
    // 引くと色が薄くなる(飽和した赤がピンクへ寄る)。
    // 掛けるだけなら色相はそのまま残る。
    FragColor = vec4(color * weight, 1.0);
}
