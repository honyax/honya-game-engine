#version 330 core

in vec3 vViewNormal;
in float vViewDepth;

// RGB = ビュー空間の法線、A = カメラからの距離。
//
// **1枚に押し込んでいる**のが今日の妥協点。本来こういうものは
// 「法線バッファ」「深度バッファ」と別々のテクスチャに書く(MRT)ものだが、
// このエンジンの <c>Framebuffer</c> はカラーアタッチメントを1枚しか挿せない
// (複数挿せるようにするのは Day 52 のディファードレンダリング)。
//
// RGBA16F の4成分にちょうど収まったので、今日はこれで足りている。
// **法線を3成分そのまま持つのは実は贅沢**で、
// 単位ベクトルは2成分に畳める(八面体マッピング)。
// 本番の G バッファはそこまで詰めて、空いた枠に粗さや金属度を入れる。
out vec4 FragColor;

void main()
{
    // **正規化はここでやる**。頂点間で補間された法線は長さが 1 でない。
    //
    // ここで正規化しても、テクスチャに書いた値を**バイリニアで読むとまた崩れる**
    // (ssao.frag が読んだあとにもう一度正規化しているのはそのため)。
    // 「正規化は使う直前に」がベクトルを補間で運ぶときの原則。
    vec3 normal = normalize(vViewNormal);

    // 深度は 16bit の半精度に入る。**遠くほど刻みが粗くなる**——
    // 半精度の相対精度は 1/1024 なので、距離 30m のところでは 3cm 刻み。
    // SSAO の半径が 0.5m なら十分だが、
    // 「遠景で AO がざらつく」ときはここの精度を疑うことになる。
    FragColor = vec4(normal, vViewDepth);
}
