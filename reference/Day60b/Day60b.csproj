<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      教養編の Labs(Day 59〜61 の CpuRayTracer)は、エンジン(HonyaEngine)とは別の独立プロジェクト。
      Day 60 は Day 59 の完全コピー + 差分(同じ題材の中でつなぐ)。

      表示は Phase 0〜1(Day 1〜10)と同じ WinForms + LockBits にした。
      レイトレーサが作るのは「画素の配列」だけなので、画面に出す手段は何でもよく、
      **GPU を1行も使わない**構成にしておくと「絵の全部を CPU が計算した」ことが疑いようもなくなる。
      Day 61 で同じ場面をコンピュートシェーダに移すとき、ここが比べる基準になる。
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      AssemblyName は明示しない(csproj のファイル名 Day60b.csproj から Day60b.dll になる)。

      名前空間は Day 番号を含めず CpuRayTracer に固定する。写経先の work/Labs/CpuRayTracer と揃い、
      Day 60・61 との差分(git diff)に namespace 行が乗らない。
      Day 61 で GPU 版が入っても名前は変えない(CPU 版と並べて比べるのがその日の主題なので)。
    -->
    <RootNamespace>CpuRayTracer</RootNamespace>

    <!--
      高DPI環境でOSに画面を引き伸ばされると「計算した1画素 = 画面の1画素」が崩れ、
      ノイズの粒が1画素ぶんに見えなくなる(隣の画素と混ざって、実際より滑らかに見える)。
      パストレーシングはノイズの量そのものが見どころなので、Day 1 と同じ理由で宣言しておく。
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
