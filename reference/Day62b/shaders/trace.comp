#version 460

// ---------------------------------------------------------------------------------------
// Day 62b: 同じシェーダを **2通りに翻訳する**。
//
//   USE_RAY_QUERY 無し … Day 62a と同じ総当たり。球を先頭から1個ずつ試す
//   USE_RAY_QUERY あり … TLAS を rayQueryEXT でたどる。**探す仕事を RT コアに渡す**
//
// C# 側(ShaderCompiler)が同じファイルを2回翻訳して、2つのパイプラインを作る。
// B キーでどちらを使うか切り替わる。**絵は完全に同じで、速さだけが違う**のを見るのが今日の目。
//
// 差分は traceScene と inShadow の2つだけ。光の計算(shadeDiffuse / sky)も、
// 光線の作り方も、bounce のループも、1文字も変えていない——
// **加速構造は「探し方」を変えるだけで、レイトレーシングの理屈を何も変えない**。
// ---------------------------------------------------------------------------------------

// ワークグループの大きさ。**C# 側の ComputeRenderer.WorkGroupSize と必ず一致させる**。
// ここを 16 にして C# を 8 のままにすると、絵の右下 3/4 が描かれないまま残る。
#ifdef USE_RAY_QUERY
// **ray query を使う宣言**。これが無いと rayQueryEXT が未定義になる。
// C# 側で VK_KHR_ray_query を有効にしてあることと、SPIR-V 1.4 以上で翻訳していることが前提
// (ShaderCompiler.cs の SpirvVersion.Shaderc15)。
#extension GL_EXT_ray_query : require
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// 出力先のストレージ画像。format 修飾子(rgba8)は
// **C# 側の VulkanImage.PixelFormat(R8G8B8A8Unorm)と一致していなければならない**。
// ずれていると検証レイヤが止めるか、色が壊れる。
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;

// 球の配列。std430 なので「vec4 が 16 バイト境界に並ぶ」だけの素直な詰め方になる
// (std140 だと配列の要素が 16 バイトに切り上げられて、C# 側と合わなくなる)。
struct Sphere {
    vec4 centerRadius;  // xyz = 中心、w = 半径
    vec4 albedoKind;    // xyz = 色、w = 材質(0 = 拡散、1 = 金属)
};

layout(set = 0, binding = 1, std430) readonly buffer Spheres {
    Sphere spheres[];
};

#ifdef USE_RAY_QUERY
// **TLAS**。ディスクリプタの型は accelerationStructureEXT で、
// 中身をシェーダから覗く手立ては無い(節点も、箱も、木の形も見えない)。
// 見えるのは「この光線をたどれ」と言って返ってくる交点だけ。
layout(set = 0, binding = 2) uniform accelerationStructureEXT topLevel;
#endif

// プッシュ定数。C# 側の PushConstants と1バイトも違ってはいけない。
layout(push_constant) uniform Push {
    vec4 positionHalfWidth;  // xyz = カメラ位置、w = 画面の半分の幅
    vec4 rightHalfHeight;    // xyz = 右方向、   w = 画面の半分の高さ
    vec4 up;                 // xyz = 上方向
    vec4 forward;            // xyz = 前方向
    int width;
    int height;
    int sphereCount;
    int mode;                // 0 = 陰影、1 = 法線、2 = 交差判定の回数、3 = 同(細かい目盛り)
} pc;

// 反射を追う回数の上限。金属に当たるたびに1減る。
// GPU には再帰が無いので(Day 61 の要点と同じ)、for ループで回す。
const int MaxBounces = 3;

// 太陽の向き(光が**来る**向き)。時刻を持たない場面なので決め打ち。
const vec3 SunDirection = normalize(vec3(-0.45, 0.85, -0.30));
const vec3 SunColor = vec3(1.0, 0.96, 0.88) * 1.9;

// 床は y = 0 の無限の平面。**配列に入れず、ここに直接書いてある**。
// 無限に広がるものは箱で囲めないので、Day 62b で BLAS を建てるときにも入れられない
// (Day 60 の Scene.Prepare が平面を「囲めない側」に置いたのと同じ線引き)。
const float FloorHeight = 0.0;

// 光線が当たったところの情報。C# の構造体と違って**参照で返せない**ので、
// 呼び出し側の変数を inout で受け取るか、この構造体をそのまま返す。
struct Hit {
    float t;
    vec3 position;
    vec3 normal;
    vec3 albedo;
    int kind;       // 0 = 拡散、1 = 金属
};

// 交差判定を何回したか。**mode 2 の絵はこれを色にしたもの**で、
// 総当たりの費用が画面のどこで高いかが一目で分かる(Day 62b の比較の土台)。
int gTests = 0;

// -----------------------------------------------------------------------------
// 光線と球(Day 59 と同じ式。half-b の形)
//
//   |P - C|^2 = r^2 に P = O + tD を入れて oc = O - C と置くと
//   t^2 + 2(oc.D)t + (oc.oc - r^2) = 0  ... D は長さ 1 なので t^2 の係数は 1
//   b = oc.D と置くと t = -b +- sqrt(b*b - c)
// -----------------------------------------------------------------------------
bool hitSphere(vec3 origin, vec3 direction, vec3 center, float radius, float tMin, float tMax, out float t) {
    gTests++;

    vec3 oc = origin - center;
    float b = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = b * b - c;
    if (discriminant < 0.0) {
        t = 0.0;
        return false;
    }

    float root = sqrt(discriminant);

    // 近いほうから試す。始点が球の中(または球が丸ごと後ろ)なら遠いほうを見る。
    t = -b - root;
    if (t <= tMin) {
        t = -b + root;
    }
    return t > tMin && t < tMax;
}

// 当たった球の情報を Hit に詰める。総当たり版と ray query 版で共通。
void fillSphereHit(int index, vec3 origin, vec3 direction, float t, out Hit hit) {
    vec4 cr = spheres[index].centerRadius;
    hit.t = t;
    hit.position = origin + t * direction;
    hit.normal = (hit.position - cr.xyz) / cr.w;
    hit.albedo = spheres[index].albedoKind.xyz;
    hit.kind = int(spheres[index].albedoKind.w);
}

#ifdef USE_RAY_QUERY
// -----------------------------------------------------------------------------
// 球を **RT コアに探させる**(今日の要点4)。
//
// 流れは4段。
//   1. rayQueryInitializeEXT で「この TLAS を、この光線で、この区間だけ」と申し込む
//   2. rayQueryProceedEXT のループが回る。**箱に当たるたびに1回止まって戻ってくる**
//   3. 止まったところで球との交差を自分で計算し、当たっていれば
//      rayQueryGenerateIntersectionEXT で「この t で確定候補にしてくれ」と返す
//   4. ループを抜けたら rayQueryGetIntersection...EXT(committed = true)で結果を読む
//
// **2 と 3 が procedural(箱)ならではの往復**。三角形を入れた BLAS なら、
// RT コアが三角形との交差まで全部やるのでループの中身は空になる
// (rayQueryProceedEXT を呼ぶだけで while が終わる)。
//
// 「RT コアが何を肩代わりするか」の答えがここにある:
//   肩代わりする … 木をたどる・箱と光線の交差・近い順の管理・いちばん近いものを残す
//   しない       … **球の式**(三角形以外を使うならこれは自分で書く)
// -----------------------------------------------------------------------------
bool traceScene(vec3 origin, vec3 direction, float tMin, float tMax, out Hit hit) {
    bool found = false;
    hit.t = tMax;

    rayQueryEXT query;

    // 第3引数はフラグ。gl_RayFlagsNoneEXT は「何も省かない」。
    // 第4引数は**カリングマスク**で、TLAS の実体のマスク(C# 側で 0xFF)と AND を取る。
    rayQueryInitializeEXT(query, topLevel, gl_RayFlagsNoneEXT, 0xFF, origin, tMin, direction, tMax);

    while (rayQueryProceedEXT(query)) {
        // 候補が箱(procedural)なら、球の式を自分で解く。
        // 第2引数の false が「候補(candidate)」、true が「確定(committed)」の意味。
        if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            int index = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
            vec4 cr = spheres[index].centerRadius;

            float t;

            // **区間の上限は「いまの確定値」でなければならない**(ここは間違えやすい)。
            // rayQueryGenerateIntersectionEXT は「いまの区間の中の t」しか受け付けず、
            // 外の t を渡したときの振る舞いは未定義。ここを tMax(1e30)にして
            // 遠い交点まで generate すると、**近い交点が後から上書きされて**
            // 画素の 5% が壊れた(確かめた。Day62b.md の検証3)。
            //
            // なお確定が1つも無いときは、この関数は光線の tMax を返す(仕様)。
            float upper = rayQueryGetIntersectionTEXT(query, true);
            if (hitSphere(origin, direction, cr.xyz, cr.w, tMin, upper, t)) {
                // これを呼ぶと、この t が新しい確定候補になる。
                // **呼ばなければ「この箱の中には何も無かった」**という意味になる。
                rayQueryGenerateIntersectionEXT(query, t);
            }
        }
    }

    // 確定した交点を読む。GeneratedEXT = 自分が GenerateIntersection で作った交点
    // (三角形なら gl_RayQueryCommittedIntersectionTriangleEXT になる)。
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionGeneratedEXT) {
        found = true;
        fillSphereHit(rayQueryGetIntersectionPrimitiveIndexEXT(query, true), origin, direction,
                      rayQueryGetIntersectionTEXT(query, true), hit);
    }

    // 床。平行(direction.y がほぼ 0)なら当たらない。
    if (abs(direction.y) > 1e-6) {
        float t = (FloorHeight - origin.y) / direction.y;
        if (t > tMin && t < hit.t) {
            found = true;
            hit.t = t;
            hit.position = origin + t * direction;
            hit.normal = vec3(0.0, 1.0, 0.0);
            hit.kind = 0;

            // 市松模様。x と z の整数部の和の偶奇で色を選ぶ(Day 59 の Material.AlbedoAt と同じ)。
            vec2 cell = floor(hit.position.xz);
            bool even = mod(cell.x + cell.y, 2.0) < 0.5;
            hit.albedo = even ? vec3(0.62) : vec3(0.18);
        }
    }

    return found;
}
#else
// -----------------------------------------------------------------------------
// 場面全体との交差。**総当たり**——球を先頭から全部試す(Day 62a のまま)。
// -----------------------------------------------------------------------------
bool traceScene(vec3 origin, vec3 direction, float tMin, float tMax, out Hit hit) {
    bool found = false;
    hit.t = tMax;

    for (int i = 0; i < pc.sphereCount; i++) {
        vec4 cr = spheres[i].centerRadius;
        float t;
        if (hitSphere(origin, direction, cr.xyz, cr.w, tMin, hit.t, t)) {
            found = true;
            fillSphereHit(i, origin, direction, t, hit);
        }
    }

    // 床。平行(direction.y がほぼ 0)なら当たらない。
    if (abs(direction.y) > 1e-6) {
        float t = (FloorHeight - origin.y) / direction.y;
        if (t > tMin && t < hit.t) {
            found = true;
            hit.t = t;
            hit.position = origin + t * direction;
            hit.normal = vec3(0.0, 1.0, 0.0);
            hit.kind = 0;

            // 市松模様。x と z の整数部の和の偶奇で色を選ぶ(Day 59 の Material.AlbedoAt と同じ)。
            vec2 cell = floor(hit.position.xz);
            bool even = mod(cell.x + cell.y, 2.0) < 0.5;
            hit.albedo = even ? vec3(0.62) : vec3(0.18);
        }
    }

    return found;
}
#endif

// 何にも当たらなかったときの色。上を向くほど青くなる素朴な空。
vec3 sky(vec3 direction) {
    float up = clamp(direction.y, 0.0, 1.0);
    vec3 gradient = mix(vec3(0.72, 0.80, 0.92), vec3(0.24, 0.42, 0.78), sqrt(up));

    // 太陽の見た目。反射の中に丸い光が映るようにしておくと、金属の球が金属らしく見える。
    float sun = pow(max(dot(direction, SunDirection), 0.0), 900.0);
    return gradient + SunColor * sun;
}

// 影の光線。**当たったかどうかだけ**が要るので、いちばん近いものを探さずに
// 1つでも当たったら即座に打ち切る(Day 59 でもやった省き方)。
bool inShadow(vec3 position, vec3 normal) {
    // 自分自身に当たらないよう、法線の向きに少し浮かせる。
    // 浮かせ方が足りないと「影の斑点(shadow acne)」が出る。
    vec3 origin = position + normal * 1e-3;

#ifdef USE_RAY_QUERY
    // 影の光線は**当たったかどうかだけ**でよいので、一次光線より省ける。
    //   gl_RayFlagsTerminateOnFirstHitEXT … 最初に確定した時点で打ち切る
    //   gl_RayFlagsOpaqueEXT              … any-hit を呼ばない(今日はどのみち Opaque)
    // ただし**箱(procedural)では自分が GenerateIntersection を呼ぶまで
    // 「当たった」ことにならない**。呼んだ時点で打ち切られる。
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevel,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        0xFF, origin, 1e-4, SunDirection, 1e30);

    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            int index = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
            vec4 cr = spheres[index].centerRadius;
            float t;
            if (hitSphere(origin, SunDirection, cr.xyz, cr.w, 1e-4, 1e30, t)) {
                rayQueryGenerateIntersectionEXT(query, t);
            }
        }
    }

    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
#else
    for (int i = 0; i < pc.sphereCount; i++) {
        vec4 cr = spheres[i].centerRadius;
        float t;
        if (hitSphere(origin, SunDirection, cr.xyz, cr.w, 1e-4, 1e30, t)) {
            return true;
        }
    }

    // 床は太陽より上に無いので、影を作らない(太陽が地平線より上にある限り)。
    return false;
#endif
}

// 拡散面の色。直接光 + 空からの一定の明るさ(環境光)。
// Day 60 のパストレーサはこの環境光を使わずに周りからの光を数えたが、
// 今日は「Vulkan が動くこと」が主題なので Day 59 の素朴な式に戻してある。
vec3 shadeDiffuse(Hit hit) {
    float ndotl = max(dot(hit.normal, SunDirection), 0.0);
    vec3 direct = (ndotl > 0.0 && !inShadow(hit.position, hit.normal)) ? SunColor * ndotl : vec3(0.0);

    // 空を「上から来る弱い光」として足す。影の中が真っ黒にならないようにするごまかし。
    // 強くしすぎると全体が白っぽく濁る(Day 59 でも同じ加減をした)。
    vec3 ambient = sky(hit.normal) * 0.13;
    return hit.albedo * (direct + ambient);
}

// 交差判定の回数を色にする(mode 2)。暗い青 → 水色 → 緑 → 黄 → 赤 の順に高い。
//
// **総当たりと ray query でこの絵を見比べるのが今日の山場**(要点5)。
//   総当たり  … 空まで色が付く。何にも当たらない光線も球を全部試している
//   ray query … ほぼ真っ暗。数えているのは**RT コアが箱に当てて戻してきた回数**だけで、
//               木をたどる費用はそもそもシェーダから見えない
//
// つまり ray query 側のこの絵は「RT コアの仕事量」ではなく
// **「RT コアがシェーダに投げ返してきた仕事の量」**を見ている。
// 同じ色尺で並べると、肩代わりされた量がそのまま差として出る。
//
// mode 3 は**目盛りだけを細かくした**同じ絵。mode 2 の共通の目盛りでは
// ray query 側が真っ黒に潰れて「どこで箱に当たっているか」が見えないので、
// 48 回で振り切る目盛りに切り替えられるようにしてある。
// ray query + mode 3 で見えるのが、**箱には当たったが球には当たらなかった費用**
// ——procedural(箱)を使うかぎり避けられない、三角形には無い持ち出し。
vec3 heatColor(int tests) {
    // 1画素あたりの目安。mode 2 は球の数の3倍(一次光線 + 影 + 反射ぶん)、mode 3 は 48 回で振り切る。
    float scale = pc.mode == 3 ? 48.0 : float(max(pc.sphereCount, 1) * 3);
    float x = clamp(float(tests) / scale, 0.0, 1.0);

    const vec3 stops[6] = vec3[6](
        vec3(0.03, 0.03, 0.12),
        vec3(0.15, 0.25, 0.85),
        vec3(0.10, 0.80, 0.85),
        vec3(0.20, 0.85, 0.25),
        vec3(0.95, 0.85, 0.15),
        vec3(0.90, 0.15, 0.10));

    float s = x * 5.0;
    int i = min(int(floor(s)), 4);
    return mix(stops[i], stops[i + 1], s - float(i));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    // ワークグループの大きさで割り切れないぶんははみ出す。**書かずに捨てる**。
    // これを忘れると画像の外に imageStore することになり、結果は未定義(たいていは無視されるが、
    // 保証は無い)。
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }

    // 画素の中心を通る光線。行列は使わず、カメラの3軸を混ぜるだけ(Camera.cs の説明)。
    vec2 ndc = vec2(
        (float(pixel.x) + 0.5) / float(pc.width) * 2.0 - 1.0,
        1.0 - (float(pixel.y) + 0.5) / float(pc.height) * 2.0);

    vec3 origin = pc.positionHalfWidth.xyz;
    vec3 direction = normalize(
        pc.forward.xyz
        + pc.rightHalfHeight.xyz * (ndc.x * pc.positionHalfWidth.w)
        + pc.up.xyz * (ndc.y * pc.rightHalfHeight.w));

    vec3 color = vec3(0.0);
    vec3 throughput = vec3(1.0);   // ここまでに掛かった反射率の積
    Hit hit;
    bool wroteNormal = false;

    // 再帰の代わりのループ。金属に当たったら反射して続け、拡散か空なら終わる。
    for (int bounce = 0; bounce <= MaxBounces; bounce++) {
        if (!traceScene(origin, direction, 1e-4, 1e30, hit)) {
            color += throughput * sky(direction);
            break;
        }

        // mode 1(法線)は**最初に当たった面**の法線だけを見せる。
        // 反射の先の法線まで混ぜると、何を見ているのか分からなくなる。
        if (pc.mode == 1 && !wroteNormal) {
            color = hit.normal * 0.5 + 0.5;
            wroteNormal = true;
            break;
        }

        if (hit.kind == 1 && bounce < MaxBounces) {
            // 金属: 反射して続ける。反射率(F0)を throughput に掛けておく。
            throughput *= hit.albedo;
            origin = hit.position + hit.normal * 1e-3;
            direction = reflect(direction, hit.normal);
            continue;
        }

        color += throughput * shadeDiffuse(hit);
        break;
    }

    if (pc.mode >= 2) {
        color = heatColor(gTests);
    } else if (pc.mode == 0) {
        // 簡単なトーンマップ + ガンマ。線形の明るさのまま出すと、
        // 太陽の当たった面が白く飛んで形が分からなくなる。
        color = color / (color + vec3(1.0));
        color = pow(color, vec3(1.0 / 2.2));
    }

    // **ここが今日の要点5**。画像の形式は RGBA の順(R8G8B8A8Unorm)だが、
    // WinForms の Format32bppRgb が欲しいバイトの並びは B, G, R, X。
    // 100 万画素ぶんを CPU で入れ替える代わりに、**書くときに .bgr で入れ替える**。
    imageStore(outImage, pixel, vec4(color.bgr, 1.0));
}
