#version 460
#extension GL_EXT_ray_tracing : require

// ---------------------------------------------------------------------------------------
// 影の光線が**何にも当たらなかった**ときに呼ばれる miss シェーダ。
//
// **今日いちばん短いシェーダ**(1行)。影の判定は「当たらなかったら呼ばれる」ので、
// 呼ばれた時点で「影ではない」と分かる。逆に言うと、
// **当たった場合は何も呼ばれない**(SkipClosestHitShader を立ててあるので)。
//
// これが RT パイプラインの考え方そのもの: **結果をシェーダの「呼ばれ方」で表す**。
// ray query なら「関数が bool を返す」で済んだものが、こういう形になる。
// ---------------------------------------------------------------------------------------

layout(location = 1) rayPayloadInEXT bool shadowed;

void main() {
    shadowed = false;
}
