#version 430 core

// ============================================================
//  Day 63a: 線を塗る
// ============================================================
//
// 法線の線と輪郭の線に使う。**陰影を付けない**——
// 線に当たる光を考えても意味が無い(線には向きしか無く、面が無い)。
// ジオメトリシェーダが決めた色をそのまま出す。

in Varying
{
    vec3 worldPosition;
    vec3 normal;
    vec4 color;
    vec2 texCoord;
} IN;

out vec4 FragColor;

void main()
{
    // 1.0 を超えた成分はブルームに拾われる(Day 31)。
    // 線が細いので、少し光らせておかないと背景に埋もれる。
    FragColor = IN.color;
}
