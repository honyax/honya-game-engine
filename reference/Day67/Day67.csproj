<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      教養編 Day 67 の 3D Gaussian Splatting ビューア。エンジン(HonyaEngine)とも、
      ほかの Labs(CpuRayTracer / HardwareRayTracer / MeshletRenderer)とも別の独立プロジェクト。
      Day 59 と同じく、前の Day のコピーではなく新しく始める。

      窓は Day 59〜61 と同じ WinForms + LockBits。GPU は「見えない窓の上の OpenGL 4.3」として使い
      (Day 61 と同じ)、描いた絵を読み戻して WinForms の窓に出す。こうしておくと、
      HUD を GDI+ で重ねられ、右クリックした画素を CPU で重ね直した答えと GPU の絵を突き合わせるのも素直になる。
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Silk.NET へ渡すバッファの中身を fixed で指すため(Day 14 以降のエンジンと同じ)。
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      AssemblyName は明示しない(csproj のファイル名 Day67.csproj から Day67.dll になる)。

      名前空間は Day 番号を含めず GaussianSplatting にする。写経先の work/Labs/GaussianSplatting と揃える。
    -->
    <RootNamespace>GaussianSplatting</RootNamespace>

    <!--
      高DPI環境でOSに画面を引き伸ばされると「計算した1画素 = 画面の1画素」が崩れる。
      今日は「1画素に楕円が何個重なっているか」を数えて見るので、1画素がぼやけると困る。
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Day 61 と同じ。Windowing を使うのは OpenGL のコンテキストを作るためだけで、窓そのものは見せない。
    -->
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GLSL は出力先へそのままコピーする。exe を建て直さずにシェーダだけ書き換えて試せるように(改造課題で効く)。
    -->
    <None Update="shaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
