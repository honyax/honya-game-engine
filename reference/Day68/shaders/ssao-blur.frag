#version 330 core

in vec2 vUv;

out vec4 FragColor;

uniform sampler2D uSource;

/// 1テクセルぶんの UV。AO バッファの大きさで決まる。
uniform vec2 uTexelSize;

/// **ノイズのタイルと同じ一辺**(4)。ここを変えるならノイズ側も変える。
uniform int uRadius;

void main()
{
    // **4x4 の単純平均**。ブルームのガウスぼかし(blur.frag)と違って、
    // 重みを付けず、横縦に分けもしない。
    //
    // 理由は「消したいものが何か」がまるで違うから。
    //   - ブルーム   … 光を**広く**にじませたい。重みの形が絵の印象を作る
    //   - SSAO のぼかし … ノイズのタイルを**ちょうど1周期ぶん**ならしたい
    //
    // ノイズを 4x4 で敷いているので、4x4 の平均を取れば
    // **タイルの中の 16 通りがちょうど1回ずつ**混ざる。
    // これで規則的な模様がきれいに消える。5x5 や 3x3 では割り切れず、
    // 薄い格子が残る——**ぼかしの大きさはノイズの周期に合わせる**。
    //
    // 重み付きにしないのも同じ理由で、
    // 中心を重くすると 16 通りの混ざり方が均等でなくなる。
    float total = 0.0;
    float count = 0.0;

    for (int y = 0; y < uRadius; y++)
    {
        for (int x = 0; x < uRadius; x++)
        {
            // 中心が -2〜+1 の範囲に来るようずらす(4 なら -2,-1,0,1)。
            // 半テクセルぶん偏るが、AO のような滑らかな値では問題にならない。
            vec2 offset = (vec2(float(x), float(y)) - float(uRadius / 2)) * uTexelSize;
            total += texture(uSource, vUv + offset).r;
            count += 1.0;
        }
    }

    // **エッジを跨いでもぼかしてしまう**のがこの素朴なぼかしの弱点。
    // 手前の物と奥の壁の境目で AO が混ざり、輪郭がにじむ。
    // 本番では深度差で重みを落とす(バイラテラルフィルタ)が、
    // 深度の読み込みが 16 回増えるので、まずは素朴なほうを置いた。
    // 改造課題3がここを直す話。
    FragColor = vec4(vec3(total / count), 1.0);
}
