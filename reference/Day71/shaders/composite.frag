#version 330 core

// **HDR パイプラインの出口**。
//
// Day 37 までは「ここだけが画面へ書く」パスだった。
// Day 38 で FXAA が後ろに付いたので、**行き先は画面とは限らない**——
// FXAA が有効なら LDR バッファへ書き、そこから FXAA が画面へ出す。
// このシェーダ自身は行き先を知らないので、1行も変わっていない。
//
// やることは5つで、**順番に意味がある**。
//   1. 露出          … 「カメラの絞り」。何を 1.0 とみなすかを決める
//   2. ブルーム合成   … 滲みを足す。**トーンマップの前**に足す(あとで理由)
//   3. グレーディング … 白点・コントラスト・彩度(Day 38)。**これもトーンマップの前**
//   4. トーンマップ   … 0〜∞ を 0〜1 へ畳む
//   5. ガンマ        … リニアな明るさを、ディスプレイが期待する符号化へ戻す
//
// 4 と 5 を逆にすると絵が破綻する。
// トーンマップの曲線は**リニアな明るさを入れる前提**で設計されているので、
// ガンマをかけた値を通すと、暗部が持ち上がりすぎて全体が白っぽくなる。
//
// 3 が 4 の前にあるのも同じ理屈。グレーディングは
// 「フィルムに写す前の光をどういじるか」であって、
// 現像済みのプリントに絵の具を足すことではない。
// 後ろに置くと、コントラストを上げた瞬間に白飛びと黒潰れが同時に起きる。

in vec2 vUv;

out vec4 FragColor;

uniform sampler2D uScene;

/// ブルームのぼかし結果、または中間バッファの表示(uDebug が 2, 3 のとき)。
uniform sampler2D uBloom;

uniform float uExposure;
uniform float uBloomIntensity;

/// 0=なし 1=Reinhard 2=ACES
uniform int uToneMap;

/// 0=最終 1=シーンのみ(ブルーム無し) 2=明部の抽出 3=ぼかし後
uniform int uDebug;

// --- カラーグレーディング(Day 38)---------------------------------------

/// グレーディングを掛けるか(Shift+F6)。
uniform int uGradeEnabled;

/// LMS 空間での増幅率。**CPU 側(ColorGrade)で1フレームに1回だけ作る**。
uniform vec3 uWhiteBalance;

/// レンズの前に置く色ガラス。単なる掛け算。
uniform vec3 uColorFilter;

/// コントラスト。1.0 が素通し。
uniform float uContrast;

/// 彩度。0 でモノクロ、1 が素通し。
uniform float uSaturation;

/// 0 なら比較なし。0 より大きいと、その x より左は**グレーディングを掛けない**。
uniform float uGradeSplit;

// --- トーンマッピング -----------------------------------------------------
//
// トーンマッピングは「0〜∞ の明るさを 0〜1 に畳む」関数。
// 写真の現像でネガの濃度を印画紙の濃度に写す作業と同じ役割で、
// 名前も映画・写真の tone mapping から来ている。
//
// **どう畳むかは物理ではなく好み**。だから正解は無く、いくつも流儀がある。

/// いちばん素朴な畳み方。x / (1 + x)。
///
/// 0 は 0 に、1 は 0.5 に、∞ は 1 に写る。単調増加で必ず 1 未満に収まる。
/// 短くて計算も軽いが、**中間の明るさが軒並み暗くなる**のが難点で、
/// 全体に眠い(コントラストの無い)絵になりやすい。
vec3 Reinhard(vec3 x)
{
    return x / (1.0 + x);
}

/// 映画のフィルムに近い畳み方の近似(Krzysztof Narkowicz による ACES のカーブフィット)。
///
/// ACES(Academy Color Encoding System)は映画業界の色管理規格で、
/// 本来は 3x3 行列を2回挟む重い変換だが、
/// **見た目のほとんどはこの1本の有理式で再現できる**というのが元記事の主張。
///
/// Reinhard との違いは両端の形。
///   - 暗部で少し持ち上がる(足がついている)ので、影が潰れずコントラストが立つ
///   - 明部が S 字で緩やかに寝るので、白飛びの手前に「粘り」が出る
/// ゲームで「フィルムっぽい」と言われる絵は、だいたいこの形をしている。
vec3 AcesFilmic(vec3 x)
{
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;

    return clamp((x * ((a * x) + b)) / ((x * ((c * x) + d)) + e), 0.0, 1.0);
}

// --- カラーグレーディング(Day 38)---------------------------------------
//
// **リニアな明るさの上で**、トーンマップの前に掛ける。
// 順番は ホワイトバランス → 色フィルタ → コントラスト → 彩度。
// この順序も映画の現像の作法から来ていて、
// **「撮影条件の補正」が先、「表現としての味付け」が後**という並びになっている。

/// リニア sRGB → LMS。錐体3種の応答へ。
const mat3 LinearToLms = mat3(
    0.390405, 0.070841, 0.023108,
    0.549941, 0.963172, 0.128021,
    0.008926, 0.001358, 0.936245);

/// LMS → リニア sRGB。上の逆行列。
const mat3 LmsToLinear = mat3(
    2.858470, -0.210182, -0.041812,
    -1.628790, 1.158200, -0.118169,
    -0.024891, 0.000324, 1.068670);

/// <summary>
/// **ホワイトバランス**。錐体ごとに感度を掛け替える(フォン・クリースの順応則)。
///
/// RGB のまま掛けないのは、色相が引きずられて肌色が転ぶから。
/// 増幅率そのものは <c>ColorGrade.ComputeWhiteBalance</c> が CPU で作っている——
/// 画素ごとに変わらない値なので、ここで計算するのは 200 万回ぶんの無駄になる。
///
/// GLSL の <c>mat3</c> は**列優先**で並ぶ。上の定数が転置して見えるのはそのため
/// (Day 13 の要点5と同じ話で、C# 側の Matrix4x4 とは並びの規約が逆)。
/// </summary>
vec3 WhiteBalance(vec3 color)
{
    vec3 lms = LinearToLms * color;
    lms *= uWhiteBalance;

    return LmsToLinear * lms;
}

/// <summary>
/// **コントラスト**。18% グレーを動かさずに、明暗の傾きだけを変える。
///
/// <b>対数の上で傾きを変える</b>のが要点。リニアのまま
/// <c>(x - 0.18) * c + 0.18</c> と書くと2つ壊れる。
///   - 暗部が負になる(0 より下は物理的に存在しない)
///   - 明部の伸びが露出の変化と噛み合わない
///     (露出は掛け算なので、対数の上では平行移動になる。
///      コントラストも対数の上で扱えば、両者が素直に合成される)
///
/// 人の明るさの感覚もほぼ対数なので、
/// **対数の上での直線が、見た目の上での直線**になる。
/// 実際のエンジンは ACEScc のような対数エンコードの上でやるが、
/// やっていることは同じ。
/// </summary>
vec3 Contrast(vec3 color)
{
    const float middleGrey = 0.18;

    // log2(0) は -∞ なので、真っ黒を潰さないための下駄。
    vec3 logColor = log2(max(color, vec3(1e-5)));

    return exp2(((logColor - log2(middleGrey)) * uContrast) + log2(middleGrey));
}

/// <summary>
/// **彩度**。輝度を軸にして、そこからの距離を伸び縮みさせる。
///
/// 係数 (0.2126, 0.7152, 0.0722) は Rec.709 の輝度で、
/// <b>リニアな明るさに掛けるためのもの</b>。
/// FXAA が使う (0.299, 0.587, 0.114) とは別物で、
/// あちらはガンマ後の値に掛ける NTSC 由来の重み——
/// <b>同じ「輝度」でも、どの空間の値に掛けるかで係数が変わる</b>。
///
/// 彩度 0 でモノクロ、1 で素通し、1 より大きいと元の色から遠ざかる。
/// 負の値を入れると補色になるが、つまみとしては用意していない。
/// </summary>
vec3 Saturation(vec3 color)
{
    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));

    return mix(vec3(luma), color, uSaturation);
}

vec3 Grade(vec3 color)
{
    color = WhiteBalance(color);
    color *= uColorFilter;
    color = Contrast(color);
    color = Saturation(color);

    // 彩度を上げたりコントラストを回したりすると、負の値が出ることがある。
    // **負の明るさは存在しない**ので、ここで床を入れておく——
    // 入れないと、このあとの ACES の有理式で符号が反転して
    // **黒いはずのところに色が付く**。
    return max(color, vec3(0.0));
}

// --- ガンマ ---------------------------------------------------------------

/// リニアな明るさ → sRGB の符号化。**画面に出す直前の最後の1手**。
///
/// ディスプレイは受け取った値をだいたい 2.2 乗して光らせるので、
/// こちらは 1/2.2 乗して渡す。そうすると打ち消し合って、
/// 計算に使ったリニアな明るさがそのまま目に届く。
///
/// 正確な sRGB は暗部だけ直線にした折れ線だが、
/// 2.2 乗との差は見た目には出ない。厳密さが要るなら
/// GL_FRAMEBUFFER_SRGB を有効にして GPU に任せる手もある。
vec3 LinearToSrgb(vec3 color)
{
    return pow(max(color, vec3(0.0)), vec3(1.0 / 2.2));
}

void main()
{
    // 中間バッファをそのまま見るモード。**パイプラインの途中を目で確かめる**ためだけにある。
    // 後処理は「絵が変」以外の症状が出ないので、段ごとに切り出して見られるかどうかで
    // 原因追跡の手間が桁で変わる。
    if (uDebug >= 2)
    {
        FragColor = vec4(LinearToSrgb(texture(uBloom, vUv).rgb * uExposure), 1.0);
        return;
    }

    vec3 color = texture(uScene, vUv).rgb;

    // 1. 露出。**トーンマップより前**に掛ける。
    //    トーンマップは「1.0 付近をどう扱うか」の関数なので、
    //    その前に「何を 1.0 とみなすか」を決めておく必要がある。
    //    暗いシーンで露出を上げれば見えるようになり、明るいシーンで下げれば白飛びが減る——
    //    カメラの絞りやシャッター速度と、役割がそのまま同じ。
    color *= uExposure;

    // 2. ブルームを足す。**トーンマップの前**。
    //    後で足すと、すでに 0〜1 に畳まれた絵の上に光を重ねることになり、
    //    明るいところが簡単に 1.0 を突き抜けて、滲みが白い板になる。
    //    前に足せば、滲みぶんもまとめて畳まれるので階調が残る。
    if (uDebug == 0)
    {
        color += texture(uBloom, vUv).rgb * uBloomIntensity * uExposure;
    }

    // 3. グレーディング(Day 38)。**トーンマップの前**。
    //
    // 比較のときは左半分を素通しにする(Shift+F11)。
    // **色は隣に置かないと分からない**——単体で見ると、
    // どんな色かぶりでも数秒で目が順応してしまって「これが普通」に見えてくる。
    if (uGradeEnabled == 1 && (uGradeSplit <= 0.0 || vUv.x > uGradeSplit))
    {
        color = Grade(color);
    }

    // 4. トーンマップ。
    if (uToneMap == 1)
    {
        color = Reinhard(color);
    }
    else if (uToneMap == 2)
    {
        color = AcesFilmic(color);
    }
    else
    {
        // 「なし」= 1.0 で切り捨てるだけ。**白飛びがそのまま出る**のを見るためのモード。
        // Day 30 までの絵は、実質ずっとこれだった。
        color = clamp(color, 0.0, 1.0);
    }

    // 5. ガンマ。
    FragColor = vec4(LinearToSrgb(color), 1.0);
}
