<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 0(Day 1)の写経用プロジェクト。
    ピクセルバッファを毎フレーム画面へ転送する土台までがここの範囲。

    Day 2 以降(Phase 1: ソフトウェアラスタライザ)は
    work/SoftwareRasterizer/ で続ける。フォルダを分けているのは、
    Phase 0 の「動く最小構成」をそのまま残しておくため。

    プロジェクト名(= csproj のファイル名)はフォルダ名と一致させること。
    .vscode/launch.json が「フォルダ名 = 出力アセンブリ名」を前提にしている。

    名前空間は Phase 単位で固定する。Phase 0 は Framebuffer。
    Phase 1(Day 2〜10)は SoftwareRasterizer に切り替わる
    (理由は CLAUDE.md を参照)。

    work 側はフォルダ名を名前空間と同じにしてあるので RootNamespace を
    書かない(未指定なら csproj のファイル名がそのまま使われる)。
    reference/DayXX 側はフォルダ名が Day 番号なので、あちらだけ明示している。

    設定は reference/Day01/Day01.csproj と同じ。各項目の意味は
    docs/plans/Day01.md の「理論の要点」を参照。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 高DPI環境でフレームバッファ1ピクセル = 画面1ピクセルを保つために必要 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
