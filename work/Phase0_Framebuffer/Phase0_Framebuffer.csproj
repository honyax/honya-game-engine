<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Day 1〜10(ソフトウェアラスタライザ)の写経用プロジェクト。
    Dayごとにフォルダは分けず、このプロジェクトを育て続ける。
    区切りは git のタグ/コミット(day01, day02 …)で残す。

    設定は reference/Day01/Day01.csproj と同じ。各項目の意味は
    docs/plans/Day01.md の「理論の要点」を参照。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>SoftwareRasterizer</RootNamespace>

    <!-- 高DPI環境でフレームバッファ1ピクセル = 画面1ピクセルを保つために必要 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
