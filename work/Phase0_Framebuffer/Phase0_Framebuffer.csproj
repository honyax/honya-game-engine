<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 0(Day 1)の写経用プロジェクト。
    ピクセルバッファを毎フレーム画面へ転送する土台までがここの範囲。

    Day 2 以降(Phase 1: ソフトウェアラスタライザ)は
    work/Phase1_SoftwareRasterizer/ で続ける。フォルダを分けているのは、
    Phase 0 の「動く最小構成」をそのまま残しておくため。

    プロジェクト名(= csproj のファイル名)はフォルダ名と一致させること。
    .vscode/launch.json が「フォルダ名 = 出力アセンブリ名」を前提にしている。

    名前空間は Day 1〜10 を通して SoftwareRasterizer で固定する
    (フォルダ名とは独立。理由は CLAUDE.md を参照)。

    設定は reference/Day01/Day01.csproj と同じ。各項目の意味は
    docs/plans/Day01.md の「理論の要点」を参照。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>SoftwareRasterizer</RootNamespace>

    <!-- 高DPI環境でフレームバッファ1ピクセル = 画面1ピクセルを保つために必要 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
