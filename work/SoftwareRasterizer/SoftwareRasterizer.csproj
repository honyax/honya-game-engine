<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 1(Day 2〜10: ソフトウェアラスタライザ)の写経用プロジェクト。
    Dayごとにフォルダは分けず、このプロジェクトを Day 10 まで育て続ける。
    区切りは git のタグ/コミット(day02, day03 …)で残す。

    プロジェクト名(= csproj のファイル名)はフォルダ名と一致させること。
    .vscode/launch.json が「フォルダ名 = 出力アセンブリ名」を前提にしている。

    名前空間は Phase 1(Day 2〜10)を通して SoftwareRasterizer で固定する。
    Phase 0(work/Framebuffer)は Framebuffer なので、そことは別になる。
    こうしておくと reference との差分に namespace 行が乗らず、
    その日の実装差分だけが見える(理由は CLAUDE.md を参照)。

    work 側はフォルダ名を名前空間と同じにしてあるので RootNamespace を
    書かない(未指定なら csproj のファイル名がそのまま使われる)。
    reference/DayXX 側はフォルダ名が Day 番号なので、あちらだけ明示している。

    リファレンスとの差分の取り方は Program.cs のコメントに書いてある
    (XMLコメントにはハイフン2つを書けないので、コマンド例はそちらに置いた)。

    設定は reference/DayXX/DayXX.csproj と同じ。各項目の意味は
    docs/plans/Day01.md の「理論の要点」を参照。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 高DPI環境でフレームバッファ1ピクセル = 画面1ピクセルを保つために必要 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
